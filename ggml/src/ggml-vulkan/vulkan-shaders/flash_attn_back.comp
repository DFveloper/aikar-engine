#version 450

#extension GL_EXT_shader_atomic_float : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter {
    uint DK;
    uint DV;
    uint N;
    uint M;
    uint HQ;
    uint HK;
    uint q_nb1;
    uint q_nb2;
    uint q_nb3;
    uint k_nb0;
    uint k_nb1;
    uint k_nb2;
    uint k_nb3;
    uint v_nb0;
    uint v_nb1;
    uint v_nb2;
    uint v_nb3;
    uint d_nb1;
    uint d_nb2;
    uint d_nb3;
    uint offs_k;
    uint offs_v;
    uint offs_s;
    uint MH;
    uint MB;
    uint causal;
    uint has_mask;
    uint has_sinks;
    float scale;
    float max_bias;
    float logit_softcap;
} p;

layout(binding = 0) readonly buffer Q_BUF { float q[]; };
#ifdef K_F16
layout(binding = 1) readonly buffer K_BUF { float16_t k[]; };
#else
layout(binding = 1) readonly buffer K_BUF { float k[]; };
#endif
#ifdef V_F16
layout(binding = 2) readonly buffer V_BUF { float16_t v[]; };
#else
layout(binding = 2) readonly buffer V_BUF { float v[]; };
#endif
layout(binding = 3) readonly buffer D_BUF { float d[]; };
layout(binding = 4) readonly buffer M_BUF { float16_t mask[]; };
layout(binding = 5) readonly buffer S_BUF { float sinks[]; };
layout(binding = 6) buffer DST_BUF { float dst[]; };

shared float reduction[128];

float load_k(uint index) {
    return float(k[index]);
}

float load_v(uint index) {
    return float(v[index]);
}

float reduce_sum(float value) {
    const uint lid = gl_LocalInvocationID.x;
    reduction[lid] = value;
    barrier();
    for (uint stride = 64; stride > 0; stride >>= 1) {
        if (lid < stride) {
            reduction[lid] += reduction[lid + stride];
        }
        barrier();
    }
    const float result = reduction[0];
    barrier();
    return result;
}

float reduce_max(float value) {
    const uint lid = gl_LocalInvocationID.x;
    reduction[lid] = value;
    barrier();
    for (uint stride = 64; stride > 0; stride >>= 1) {
        if (lid < stride) {
            reduction[lid] = max(reduction[lid], reduction[lid + stride]);
        }
        barrier();
    }
    const float result = reduction[0];
    barrier();
    return result;
}

void main() {
    const uint lid = gl_LocalInvocationID.x;
    const uint row = gl_WorkGroupID.x;
    const uint iq = row%p.N;
    const uint iqh = (row/p.N)%p.HQ;
    const uint ib = row/(p.N*p.HQ);
    const uint ikh = iqh/(p.HQ/p.HK);
    const uint key_end = p.causal != 0 ? min(p.M, p.M - p.N + iq + 1) : p.M;
    const uint q_base = iq*p.q_nb1 + iqh*p.q_nb2 + ib*p.q_nb3;
    const uint d_base = iqh*p.d_nb1 + iq*p.d_nb2 + ib*p.d_nb3;
    const uint mask_base = iq*p.M + (iqh%p.MH)*p.M*p.N + (ib%p.MB)*p.M*p.N*p.MH;

    const uint n_head_log2 = 1u << uint(floor(log2(float(p.HQ))));
    const float m0 = exp2(-p.max_bias/float(n_head_log2));
    const float m1 = exp2(-(p.max_bias/2.0)/float(n_head_log2));
    const float slope = p.max_bias > 0.0 ?
        (iqh < n_head_log2 ? pow(m0, float(iqh + 1)) : pow(m1, float(2*(iqh - n_head_log2) + 1))) : 1.0;

    float local_max = -1.0/0.0;
    for (uint ik = lid; ik < key_end; ik += 128) {
        const float mv = p.has_mask != 0 ? slope*float(mask[mask_base + ik]) : 0.0;
        if (isinf(mv) && mv < 0.0) {
            continue;
        }
        const uint k_base = ik*p.k_nb1 + ikh*p.k_nb2 + ib*p.k_nb3;
        float dot = 0.0;
        for (uint id = 0; id < p.DK; ++id) {
            dot += q[q_base + id]*load_k(k_base + id*p.k_nb0);
        }
        float score = dot*p.scale;
        if (p.logit_softcap != 0.0) {
            score = p.logit_softcap*tanh(score/p.logit_softcap);
        }
        local_max = max(local_max, score + mv);
    }
    if (lid == 0 && p.has_sinks != 0) {
        local_max = max(local_max, sinks[iqh]);
    }
    const float max_score = reduce_max(local_max);
    if (isinf(max_score) && max_score < 0.0) {
        return;
    }

    float local_sum = 0.0;
    float local_weighted_dp = 0.0;
    for (uint ik = lid; ik < key_end; ik += 128) {
        const float mv = p.has_mask != 0 ? slope*float(mask[mask_base + ik]) : 0.0;
        if (isinf(mv) && mv < 0.0) {
            continue;
        }
        const uint k_base = ik*p.k_nb1 + ikh*p.k_nb2 + ib*p.k_nb3;
        const uint v_base = ik*p.v_nb1 + ikh*p.v_nb2 + ib*p.v_nb3;
        float dot = 0.0;
        for (uint id = 0; id < p.DK; ++id) {
            dot += q[q_base + id]*load_k(k_base + id*p.k_nb0);
        }
        float score = dot*p.scale;
        if (p.logit_softcap != 0.0) {
            score = p.logit_softcap*tanh(score/p.logit_softcap);
        }
        const float weight = exp(score + mv - max_score);
        float dp = 0.0;
        for (uint id = 0; id < p.DV; ++id) {
            dp += d[d_base + id]*load_v(v_base + id*p.v_nb0);
        }
        local_sum += weight;
        local_weighted_dp += weight*dp;
    }
    if (lid == 0 && p.has_sinks != 0) {
        local_sum += exp(sinks[iqh] - max_score);
    }
    const float sum = reduce_sum(local_sum);
    const float weighted_dp = reduce_sum(local_weighted_dp);
    const float inv_sum = 1.0/sum;
    const float mean = weighted_dp*inv_sum;

    for (uint ik = lid; ik < key_end; ik += 128) {
        const float mv = p.has_mask != 0 ? slope*float(mask[mask_base + ik]) : 0.0;
        if (isinf(mv) && mv < 0.0) {
            continue;
        }
        const uint k_base = ik*p.k_nb1 + ikh*p.k_nb2 + ib*p.k_nb3;
        const uint v_base = ik*p.v_nb1 + ikh*p.v_nb2 + ib*p.v_nb3;
        float dot = 0.0;
        for (uint id = 0; id < p.DK; ++id) {
            dot += q[q_base + id]*load_k(k_base + id*p.k_nb0);
        }
        float score = dot*p.scale;
        float derivative = p.scale;
        if (p.logit_softcap != 0.0) {
            const float t = tanh(score/p.logit_softcap);
            score = p.logit_softcap*t;
            derivative *= 1.0 - t*t;
        }
        const float prob = exp(score + mv - max_score)*inv_sum;
        float dp = 0.0;
        for (uint id = 0; id < p.DV; ++id) {
            dp += d[d_base + id]*load_v(v_base + id*p.v_nb0);
            atomicAdd(dst[p.offs_v + id + p.DV*(ik + p.M*(ikh + p.HK*ib))], prob*d[d_base + id]);
        }
        const float ds = prob*(dp - mean)*derivative;
        for (uint id = 0; id < p.DK; ++id) {
            atomicAdd(dst[id + p.DK*(iq + p.N*(iqh + p.HQ*ib))], ds*load_k(k_base + id*p.k_nb0));
            atomicAdd(dst[p.offs_k + id + p.DK*(ik + p.M*(ikh + p.HK*ib))], ds*q[q_base + id]);
        }
    }

    if (lid == 0 && p.has_sinks != 0) {
        const float p_sink = exp(sinks[iqh] - max_score)*inv_sum;
        atomicAdd(dst[p.offs_s + iqh], -p_sink*mean);
    }
}
